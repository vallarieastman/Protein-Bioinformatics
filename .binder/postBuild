#!/usr/bin/env bash
# .binder/postBuild  — robust kernel registration for Binder

# Find a working Python inside the env repo2docker builds
if [ -n "${CONDA_PREFIX:-}" ] && [ -x "$CONDA_PREFIX/bin/python" ]; then
  PY="$CONDA_PREFIX/bin/python"
elif [ -x "/srv/conda/envs/notebook/bin/python" ]; then
  PY="/srv/conda/envs/notebook/bin/python"
elif [ -x "/opt/conda/envs/notebook/bin/python" ]; then
  PY="/opt/conda/envs/notebook/bin/python"
else
  PY="python"  # fallback
fi

# Register a friendly kernel name; ignore if already installed
"$PY" -m ipykernel install --user --name md-311 --display-name "Python (md-311)" || true

# Widgets usually OK on JLab 3/4; keep this harmless
jupyter nbextension enable --py widgetsnbextension --sys-prefix || true
